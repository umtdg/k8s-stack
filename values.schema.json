{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "values.yaml",
  "description": "What each value must look like on its own. How values relate to each other is checked in templates/_validate.tpl.",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo", "domain", "owner", "network", "ingress", "tls", "storage", "postgres", "secrets", "argoDefaults", "services"],

  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "description": "One DNS label: lower-case letters, digits and hyphens.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "objectName": {
      "description": "Name of a Kubernetes object.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
    },
    "ipv4": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$"
    },
    "argo": {
      "description": "How Argo CD treats a service. Every key is optional on a service and required in argoDefaults.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": { "$ref": "#/definitions/objectName" },
        "managed": { "type": "boolean" },
        "automated": { "type": "boolean" },
        "prune": { "type": "boolean" },
        "selfHeal": { "type": "boolean" },
        "syncOptions": { "type": "array", "items": { "type": "string" } },
        "retry": { "type": "object" },
        "ignoreDifferences": { "type": "array", "items": { "type": "object" } },
        "migrateFrom": { "type": "string" }
      }
    },
    "service": {
      "description": "One entry of the catalog. Keys not listed here are allowed: a service may carry data of its own for its values.tpl.yaml.",
      "type": "object",
      "required": ["dir", "wave", "namespace"],
      "properties": {
        "dir": {
          "description": "Path inside the repository: no leading or trailing slash, no segment starting with a dot.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
        },
        "wave": { "type": "integer" },
        "namespace": { "$ref": "#/definitions/objectName" },
        "createNamespace": { "type": "boolean" },
        "namespaceLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "releaseName": { "$ref": "#/definitions/objectName" },
        "skipDryRunOnMissingResource": { "type": "boolean" },
        "host": {
          "description": "A single label: the wildcard certificate covers exactly one level under the domain.",
          "$ref": "#/definitions/label"
        },
        "git": {
          "description": "The chart lives in another git repository.",
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "path", "ref"],
          "properties": {
            "repo": { "$ref": "#/definitions/text" },
            "path": { "$ref": "#/definitions/text" },
            "ref": { "$ref": "#/definitions/text" }
          }
        },
        "argo": { "$ref": "#/definitions/argo" }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "name"],
      "properties": {
        "service": { "$ref": "#/definitions/label" },
        "name": { "$ref": "#/definitions/objectName" },
        "key": { "$ref": "#/definitions/text" }
      }
    }
  },

  "properties": {
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision"],
      "properties": {
        "url": { "$ref": "#/definitions/text" },
        "revision": { "$ref": "#/definitions/text" }
      }
    },

    "domain": {
      "description": "A lower-case DNS name.",
      "type": "string",
      "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}$"
    },

    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "user"],
      "properties": {
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" },
        "user": { "$ref": "#/definitions/text" }
      }
    },

    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeIP", "ingressVIP", "pool"],
      "properties": {
        "nodeIP": { "$ref": "#/definitions/ipv4" },
        "ingressVIP": { "$ref": "#/definitions/ipv4" },
        "pool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "start", "end", "interface"],
          "properties": {
            "name": { "$ref": "#/definitions/objectName" },
            "start": { "$ref": "#/definitions/ipv4" },
            "end": { "$ref": "#/definitions/ipv4" },
            "interface": { "$ref": "#/definitions/text" }
          }
        }
      }
    },

    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "wildcardSecret"],
      "properties": {
        "className": { "$ref": "#/definitions/objectName" },
        "wildcardSecret": { "$ref": "#/definitions/objectName" }
      }
    },

    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "resolvers"],
      "properties": {
        "issuer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prod", "staging"],
          "properties": {
            "prod": { "$ref": "#/definitions/objectName" },
            "staging": { "$ref": "#/definitions/objectName" }
          }
        },
        "resolvers": {
          "description": "host:port, at least one.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[^:\\s]+:[0-9]+$" }
        }
      }
    },

    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "hostPath"],
      "properties": {
        "className": { "$ref": "#/definitions/objectName" },
        "hostPath": {
          "description": "An absolute path on the node.",
          "type": "string",
          "pattern": "^/"
        }
      }
    },

    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster", "port", "databases"],
      "properties": {
        "cluster": { "$ref": "#/definitions/objectName" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "databases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "secret", "consumer"],
            "properties": {
              "name": {
                "description": "A plain Postgres identifier: it is the role, the database and its owner.",
                "type": "string",
                "pattern": "^[a-z_][a-z0-9_]*$"
              },
              "secret": { "$ref": "#/definitions/objectName" },
              "consumer": {
                "type": "object",
                "additionalProperties": false,
                "required": ["service", "secret"],
                "properties": {
                  "service": { "$ref": "#/definitions/label" },
                  "secret": { "$ref": "#/definitions/objectName" }
                }
              }
            }
          }
        }
      }
    },

    "secrets": {
      "type": "object",
      "required": ["cloudflare", "giteaAdmin", "argoRepo"],
      "additionalProperties": { "$ref": "#/definitions/secret" },
      "properties": {
        "cloudflare": {
          "allOf": [{ "$ref": "#/definitions/secret" }, { "required": ["key"] }]
        }
      }
    },

    "argoDefaults": {
      "allOf": [
        { "$ref": "#/definitions/argo" },
        { "required": ["project", "managed", "automated", "prune", "selfHeal", "syncOptions", "retry", "ignoreDifferences", "migrateFrom"] }
      ]
    },

    "services": {
      "description": "The catalog. Other services derive values from the four required ones.",
      "type": "object",
      "required": ["argocd", "ingress-nginx", "cert-manager", "postgres"],
      "propertyNames": {
        "allOf": [{ "$ref": "#/definitions/label" }, { "not": { "const": "root" } }]
      },
      "additionalProperties": { "$ref": "#/definitions/service" }
    },

    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": {
          "description": "Emit an Application for every service, managed or not.",
          "type": "boolean"
        }
      }
    },

    "global": { "type": "object" }
  }
}
