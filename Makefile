WRAPPERS := $(patsubst %/Chart.yaml,%,$(shell grep -l '^dependencies:' platform/*/Chart.yaml apps/*/Chart.yaml))

.PHONY: generate config deps validate test test-charts

generate:
	rm -rf $(GENERATED) && mkdir -p $(GENERATED)
	helm template homelab . | ( \
		cd $(GENERATED) && yq -s '.metadata.name + ".yaml"' \
		'... head_comment="" | . head_comment="This file is generated by `make generate`. Edit values.yaml or temlates/ instead."' \
	)

config:
	@helm template homelab . -s templates/config.yaml \
		| yq '.data | to_entries | .[] | .key + "=" + .value'

deps:
	@for dir in $(WRAPPERS); do \
		helm dependency update $$dir || exit 1; \
	done

validate:
	helm lint . --quiet
	helm template homelab . >/dev/null

test: validate
	test -d $(GENERATED)
	tmp=$$(mktemp -d) && $(MAKE) -s generate GENERATED=$$tmp && diff -r $(GENERATED) $$tmp

	tests/style_test.sh

test-charts:
	tests/charts_test.sh
